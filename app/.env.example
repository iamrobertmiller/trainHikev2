# Supabase — get from supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PTV Timetable API v3 — register free at:
# https://www.ptv.vic.gov.au/footer/data-and-reporting/datasets/ptv-timetable-api/
VITE_PTV_DEV_ID=your-dev-id-here
VITE_PTV_API_KEY=your-api-key-here

# OpenRouteService — trail-preferring routing (optional)
# Sign up free at openrouteservice.org → Dashboard → Request a token
# Without this the app falls back to OSRM foot profile (still works)
VITE_ORS_API_KEY=your-ors-token-here
